# Este archivo es OPCIONAL. La app de Entra del proyecto ya viene en
# backend/entra.json, versionada, así que arrancar no requiere configurar nada.
# Esto sirve sólo para apuntar a OTRO tenant sin tocar ese archivo.
#
# .env NUNCA va al repositorio. Lo que pongas acá le gana a entra.json.
#
# ── MODO DELEGADO (el que usa el proyecto; no depende de un administrador) ──
# Entrás vos con tu cuenta corporativa y la API te ve con TUS permisos.
# No lleva secreto.
#
# Los dos salen de Entra → tu app → Información general, uno debajo del otro:
#   CLIENT_ID = «Id. de aplicación (cliente)»
#   TENANT_ID = «Id. de directorio (inquilino)»
# CLIENT_ID=00000000-0000-0000-0000-000000000000
# TENANT_ID=00000000-0000-0000-0000-000000000000

# ── MODO SERVICE PRINCIPAL (corre sin nadie adelante; requiere IT) ─────
# Descomentá CLIENT_SECRET y completá TENANT_ID para usar este modo.
# Requiere que un administrador habilite el tenant setting "Allow service
# principals to use Power BI APIs" y agregue la app al workspace.
# No funciona con modelos que usan RLS ni SSO.
# CLIENT_SECRET=pegar-aca-el-value-del-secreto

# AUTH_MODO=delegado     # fuerza el modo, si querés ser explícito

# ── Tablero por defecto ───────────────────────────────────────────────
# También se guardan en backend/modelo.json desde el artefacto.
# POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# POWERBI_DATASET_ID=00000000-0000-0000-0000-000000000000

# Orígenes autorizados a llamar a este backend, separados por coma.
# Vacío = mismo origen solamente (serví el artefacto desde este backend).
ORIGENES_PERMITIDOS=

PORT=3000
